{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-only taserjs playground: edit files, see real types, run requests.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src vite.config.ts",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@taserjs/cli": "workspace:*",
    "@taserjs/runtime": "workspace:*",
    "esbuild-wasm": "0.28.2",
    "lucide-react": "^1.28.0",
    "lz-string": "1.5.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.24.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@taserjs/client": "workspace:*",
    "@taserjs/router": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.1.2",
    "pathe": "^2.0.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.1.10",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
