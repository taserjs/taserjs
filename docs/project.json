{
  "name": "docs",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "docs/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": { "script": "build" },
      "outputs": ["{projectRoot}/.output"]
    },
    "dev": {
      "executor": "nx:run-script",
      "options": { "script": "dev" }
    },
    "typecheck": {
      "executor": "nx:run-script",
      "options": { "script": "types:check" }
    },
    "preview": {
      "executor": "nx:run-script",
      "options": { "script": "preview" },
      "dependsOn": ["build"]
    },
    "start": {
      "executor": "nx:run-script",
      "options": { "script": "start" },
      "dependsOn": ["build"]
    }
  }
}
