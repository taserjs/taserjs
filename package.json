{
  "name": "taserjs",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test --filter=@taserjs/router -- --watch",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "turbo run clean",
    "bench": "pnpm --filter @taserjs/router-core bench",
    "docs:dev": "turbo run dev --filter=docs",
    "docs:build": "turbo run build --filter=docs",
    "changeset": "changeset",
    "build-packages": "turbo run build --filter=!docs",
    "version-packages": "changeset version",
    "release": "pnpm build-packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.6.2"
}
