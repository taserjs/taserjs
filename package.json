{
  "name": "taserjs",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:watch": "nx run router:test -- --watch",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "format": "pnpm lint:fix",
    "clean": "nx run-many -t clean && rimraf node_modules/.cache/taser.json",
    "docs:dev": "nx run docs:dev",
    "docs:build": "nx run docs:build",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-jsr-versions.mjs",
    "release": "nx run-many -t build --exclude=docs && changeset publish && deno publish"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.6.2",
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "nx": "^22.3.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.1.10"
  }
}
