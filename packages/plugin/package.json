{
  "name": "@taserjs/plugin",
  "version": "0.2.8",
  "description": "Universal bundler plugin for Taser.js",
  "keywords": [
    "bundler",
    "file-based-routing",
    "nextjs",
    "nitro",
    "rest-api",
    "tanstack-start",
    "taserjs",
    "type-safe-api",
    "typescript",
    "vite-plugin"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taserjs/taserjs.git",
    "directory": "packages/plugin"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./vite": "./dist/vite.js",
    "./rollup": "./dist/rollup.js",
    "./rolldown": "./dist/rolldown.js",
    "./webpack": "./dist/webpack.js",
    "./rspack": "./dist/rspack.js",
    "./esbuild": "./dist/esbuild.js",
    "./nitro": "./dist/nitro.js",
    "./next": "./dist/next.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@taserjs/cli": "workspace:^",
    "@taserjs/runtime": "workspace:^",
    "pathe": "^2.0.3",
    "unplugin": "^2.3.11"
  },
  "devDependencies": {
    "create-taserjs": "workspace:*",
    "publint": "^0.3.22",
    "rimraf": "^6.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
