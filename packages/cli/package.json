{
  "name": "@taserjs/cli",
  "version": "0.2.8",
  "description": "Unified CLI: scanning and manifest code generation for Taser.js",
  "keywords": [
    "api-routes",
    "cli",
    "codegen",
    "file-based-routing",
    "manifest",
    "rest-api",
    "route-scanner",
    "taserjs",
    "type-safe-api",
    "typescript"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taserjs/taserjs.git",
    "directory": "packages/cli"
  },
  "bin": {
    "taser": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "jiti": "^2.4.2",
    "oxc-parser": "^0.149.0",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@taserjs/router": "workspace:*",
    "@taserjs/runtime": "workspace:*",
    "publint": "^0.3.22",
    "rimraf": "^6.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
