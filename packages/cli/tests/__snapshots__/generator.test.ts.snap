    "/admin/*": layout_1,
} as const;

export const routeManifest = {
  layouts: layoutManifest,
  routes: {
    "/admin": {
      GET: {
        layouts: ["/*", "/admin/*"],
        route: route_0,
      },
    },
    "/admin/users/:id": {
      GET: {
        layouts: ["/*", "/admin/*"],
        route: route_1,
      },
    },
    "/": {
      GET: {
        layouts: ["/*"],
        route: route_2,
      },
    },
  },
} as const;

