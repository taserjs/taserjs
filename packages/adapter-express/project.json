{
  "name": "adapter-express",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/adapter-express/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": { "script": "build" },
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["router-utils:build", "router:build"]
    },
    "typecheck": {
      "executor": "nx:run-script",
      "options": { "script": "typecheck" },
      "dependsOn": ["router-utils:build", "router:build"]
    },
    "test": {
      "executor": "nx:run-script",
      "options": { "script": "test" },
      "dependsOn": ["router-utils:build", "router:build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "packages/adapter-express"
      }
    },
    "clean": {
      "executor": "nx:run-script",
      "options": { "script": "clean" }
    }
  }
}
