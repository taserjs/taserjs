{
  "name": "@taserjs/adapter-express",
  "version": "0.0.3",
  "description": "Express adapter for Taser router",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taserjs/taserjs.git",
    "directory": "packages/adapter-express"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "vite build && publint --strict",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@taserjs/router": "workspace:*",
    "@taserjs/router-utils": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/vite-config": "^0.6.0",
    "@types/express": "^5.0.3",
    "express": "^5.1.0",
    "publint": "^0.3.22",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
