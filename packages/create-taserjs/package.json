{
  "name": "create-taserjs",
  "version": "0.3.0",
  "description": "Scaffold a new Taser.js application",
  "keywords": [
    "api-starter",
    "boilerplate",
    "create-app",
    "file-based-routing",
    "rest-api",
    "scaffold",
    "starter",
    "taserjs",
    "type-safe-api",
    "typescript"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taserjs/taserjs.git",
    "directory": "packages/create-taserjs"
  },
  "bin": {
    "create-taserjs": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "pnpm run build && node scripts/scaffold-e2e.mjs",
    "lint": "oxlint .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "magicast": "^0.5.5",
    "package-manager-detector": "^1.8.0",
    "picocolors": "^1.1.1",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35",
    "publint": "^0.3.22",
    "rimraf": "^6.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
