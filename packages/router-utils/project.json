{
  "name": "router-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/router-utils/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": { "script": "build" },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-script",
      "options": { "script": "typecheck" }
    },
    "test": {
      "executor": "nx:run-script",
      "options": { "script": "test" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "packages/router-utils"
      }
    },
    "clean": {
      "executor": "nx:run-script",
      "options": { "script": "clean" }
    }
  }
}
