{
  "name": "@taserjs/router-utils",
  "version": "0.1.6",
  "description": "HTTP reply helpers, streams, and Standard Schema validation for Taser",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taserjs/taserjs.git",
    "directory": "packages/router-utils"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./reply": {
      "import": {
        "types": "./dist/esm/reply.d.ts",
        "default": "./dist/esm/reply.js"
      },
      "require": {
        "types": "./dist/cjs/reply.d.cts",
        "default": "./dist/cjs/reply.cjs"
      }
    },
    "./stream": {
      "import": {
        "types": "./dist/esm/stream.d.ts",
        "default": "./dist/esm/stream.js"
      },
      "require": {
        "types": "./dist/cjs/stream.d.cts",
        "default": "./dist/cjs/stream.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/esm/http.d.ts",
        "default": "./dist/esm/http.js"
      },
      "require": {
        "types": "./dist/cjs/http.d.cts",
        "default": "./dist/cjs/http.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "vite build && publint --strict",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "mrmime": "^2.0.1"
  },
  "devDependencies": {
    "@tanstack/vite-config": "^0.6.0",
    "publint": "^0.3.22",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
