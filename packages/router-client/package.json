{
  "name": "@taserjs/router-client",
  "version": "0.1.11",
  "description": "Type-safe HTTP client for Taser.js applications",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taserjs/taserjs.git",
    "directory": "packages/router-client"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "vite build && publint --strict",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@taserjs/router-utils": "workspace:*",
    "object-to-formdata": "^5.0.0"
  },
  "devDependencies": {
    "@tanstack/vite-config": "^0.6.0",
    "@taserjs/router": "workspace:*",
    "publint": "^0.3.22",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@taserjs/router": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@taserjs/router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
