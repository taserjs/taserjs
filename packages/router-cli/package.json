{
  "name": "@taserjs/router-cli",
  "version": "0.0.0",
  "description": "CLI for Taser route manifest generation",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "taser": "./dist/esm/cli.js"
  },
  "files": [
    "dist",
    "src",
    "taser.config.schema.json"
  ],
  "exports": {
    "./taser.config.schema.json": "./taser.config.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "generate:schema": "node scripts/generate-config-schema.js",
    "build": "pnpm run generate:schema && vite build && publint --strict",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run generate:schema && vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@taserjs/router-generator": "workspace:*",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/vite-config": "^0.6.0",
    "@types/yargs": "^17.0.33",
    "publint": "^0.3.22",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taserjs/taserjs.git",
    "directory": "packages/router-cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
