{
  "name": "@taserjs/router-cli",
  "version": "0.1.0",
  "description": "CLI for Taser route manifest generation",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taserjs/taserjs.git",
    "directory": "packages/router-cli"
  },
  "bin": {
    "taser": "./dist/esm/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "rimraf dist .taser",
    "build": "vite build && publint --strict",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@taserjs/router-generator": "workspace:*",
    "jiti": "^2.7.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@tanstack/vite-config": "^0.6.0",
    "@types/yargs": "^17.0.33",
    "oxfmt": "^0.63.0",
    "publint": "^0.3.22",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
