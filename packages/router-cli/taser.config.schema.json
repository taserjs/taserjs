{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taserjs.dev/schemas/taser.config.schema.json",
  "title": "Taser Router CLI Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "routes": {
      "default": "src/routes",
      "type": "string"
    },
    "output": {
      "default": "src/routeManifest.gen.ts",
      "type": "string"
    },
    "entry": {
      "default": "#src/taser.js",
      "type": "string"
    },
    "extension": {},
    "ignorePrefix": {
      "default": "-",
      "type": "string"
    },
    "ignorePattern": {
      "type": "string"
    },
    "quiet": {
      "default": false,
      "type": "boolean"
    },
    "quotes": {
      "default": "single",
      "type": "string",
      "enum": ["single", "double"]
    },
    "semi": {
      "default": false,
      "type": "boolean"
    },
    "header": {
      "default": [
        "/* eslint-disable */",
        "// Auto-generated by @taserjs/router-generator — do not edit."
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "footer": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "format": {
      "default": true,
      "type": "boolean"
    },
    "validate": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "routes",
    "output",
    "entry",
    "extension",
    "ignorePrefix",
    "quiet",
    "quotes",
    "semi",
    "header",
    "footer",
    "format",
    "validate"
  ]
}
