{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "paths": {
      "#taserjs/router": [
        "./src/server/taser.ts"
      ]
    }
  },
  "include": [
    "src",
    ".taser/types/**/*.d.ts",
    "vite.config.ts",
  ]
}
